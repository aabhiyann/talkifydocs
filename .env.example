# =============================================================================
# TalkifyDocs environment variables
# Copy this file to `.env.local` (preferred for dev) or `.env` and fill in
# real values. NEVER commit real secrets — both `.env` and `.env*.local` are
# gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/talkifydocs?sslmode=require"

# -----------------------------------------------------------------------------
# Auth — Clerk (required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Optional, only needed when handling Clerk webhooks
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Clerk URL overrides (defaults shown)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# -----------------------------------------------------------------------------
# AI providers (required)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-replace_me
GROQ_API_KEY=gsk_replace_me
GOOGLE_API_KEY=replace_me

# -----------------------------------------------------------------------------
# Vector store — Pinecone (required)
# -----------------------------------------------------------------------------
PINECONE_API_KEY=replace_me
PINECONE_ENVIRONMENT=gcp-starter
# Optional override for the index name
PINECONE_INDEX=talkifydocs

# -----------------------------------------------------------------------------
# Payments — Stripe (required)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# -----------------------------------------------------------------------------
# File storage — Vercel Blob (required)
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# -----------------------------------------------------------------------------
# File storage — UploadThing (optional, legacy fallback)
# -----------------------------------------------------------------------------
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# -----------------------------------------------------------------------------
# Cache / rate limiting — Upstash Redis (optional)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Self-hosted Redis fallback (optional)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Observability — Sentry (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Set automatically on Vercel; usually unset locally
VERCEL_URL=
# Optional override for absolute URL helper
NEXT_PUBLIC_APP_URL=
